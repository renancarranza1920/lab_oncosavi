# Historial de Git
.git
.gitignore

# Variables privadas
.env
.env.*
!.env.example

# Dependencias generadas
node_modules
vendor

# Recursos que Vite generará nuevamente
public/build
public/hot
public/storage

# Registros temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bases de datos y archivos comprimidos
*.sql
*.zip
*.rar

# Archivos de desarrollo
.phpunit.cache
.phpunit.result.cache
.idea
.vscode
.fleet
.DS_Store

# Credenciales, archivos de usuarios y cachés pertenecen a los volúmenes.
storage/app/**
storage/logs/**
storage/framework/cache/data/**
storage/framework/sessions/**
storage/framework/views/**
bootstrap/cache/*.php
!storage/**/.gitignore

# Archivos de Docker que no necesita Laravel
Dockerfile
compose.yaml
docker-compose.yml
docker-compose.yaml
