APP_NAME="ONCOSAVI · PRUEBAS"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://URL-TEMPORAL-DE-TU-ALOJAMIENTO
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_SV

# Base nueva, exclusiva de pruebas. Completar en el alojamiento.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

TEST_DEMO_ENABLED=true
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=pruebas@example.invalid
MAIL_FROM_NAME="${APP_NAME}"
BCRYPT_ROUNDS=12
IMPRESION_ETIQUETAS_HABILITADA=false
VITE_APP_NAME="${APP_NAME}"
